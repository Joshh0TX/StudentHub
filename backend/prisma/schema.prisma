generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  f_name      String
  l_name      String
  profileImage String?
  coverImage String?
  bio        String?
  location   String?
  course     String?
  department String?
  level      Int?
  skills     Json?
  interests  Json?
  badges     Json?
  achievements Json?
  projects    Json?
  socials    Json?
  createdAt  DateTime @default(now())
  requestsSent     FriendRequest[] @relation("RequestsSent")
  requestsReceived FriendRequest[] @relation("RequestsReceived")

  // Academic
  courseMemberships CourseMember[]
  createdCourses    Course[]       @relation("UserCreatedCourses")

  // Social
  posts     Post[]
  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  // Existing features
  resources     Resource[]
  pastQuestions PastQuestion[]
  studyGroups   StudyGroup[]
  GroupMember   StudyGroupMember[]
  assignments Assignment[]
  timetables Timetable[]

  // Study group schedules created by this user
  studyGroupSchedules StudyGroupSchedule[]

  // Marketplace
  store      Store?
  orders     Order[]
  reviews    Review[]
  favourites StoreFavourite[]
}

model Course {
  id         String   @id @default(uuid())
  name       String
  courseCode String
  classCode  String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  creator     User             @relation("UserCreatedCourses", fields: [createdBy], references: [id])
  members     CourseMember[]
  assignments Assignment[]
}

model CourseMember {
  id       String @id @default(uuid())
  userId   String
  courseId String
  role     String @default("student")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  courseId    String
  createdBy   String
  createdAt   DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model Timetable {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  department String?
  year       Int?
  createdBy  String?
  createdAt  DateTime @default(now())

  creator User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  classes TimetableClass[]
}

model TimetableClass {
  id          String    @id @default(cuid())
  timetableId Int                          // ← must be Int to match Timetable.id
  subject     String
  location    String?
  day         String
  startTime   String
  endTime     String
  colorIdx    Int       @default(0)
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
}

model Post {
  id        String   @id @default(uuid())
  content   String
  image     String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String

  follower  User @relation("followers", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model StudyGroup {
  id           String   @id @default(cuid())
  name         String
  course_code  String
  course_title String
  description  String?
  max_members  Int
  department   String
  year         Int?
  createdBy    String
  createdAt    DateTime @default(now())

  creator   User               @relation(fields: [createdBy], references: [id])
  resources Resource[]
  members   StudyGroupMember[]
  schedules StudyGroupSchedule[]
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime   @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id])
  user  User       @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model StudyGroupSchedule {
  id          String   @id @default(cuid())
  groupId     String
  createdBy   String
  title       String
  date_time   DateTime
  location    String?

  is_online   Boolean  @default(false)
  meeting_url String?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User       @relation(fields: [createdBy], references: [id])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  type        String
  url         String
  description String?
  department  String
  courseCode  String
  courseTitle String?
  year        Int?
  groupId     String?
  uploadedBy  String
  createdAt   DateTime @default(now())

  //for file uploads
  isFile      Boolean  @default(false)
  fileName    String?
  fileSize    Int?
  mimeType    String?

  group    StudyGroup? @relation(fields: [groupId], references: [id])
  uploader User        @relation(fields: [uploadedBy], references: [id])
}

model PastQuestion {
  id         String   @id @default(uuid())
  courseCode String
  year       Int
  fileUrl    String
  uploadedBy String
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id])
}

model Store {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("goods")
  image       String?
  visits      Int      @default(0)
  ownerId     String   @unique
  createdAt   DateTime @default(now())

  owner      User             @relation(fields: [ownerId], references: [id])
  products   Product[]
  contacts   StoreContact[]
  favourites StoreFavourite[]
}

model StoreContact {
  id      String @id @default(uuid())
  storeId String
  type    String
  value   String

  store Store @relation(fields: [storeId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  image       String?
  images      String[]
  type        String   @default("goods")
  category    String
  locations   String[]
  visits      Int      @default(0)
  storeId     String
  createdAt   DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id])
  orders  Order[]
  reviews Review[]
}

model Order {
  id           String   @id @default(uuid())
  productId    String
  buyerId      String
  quantity     Int      @default(1)
  deliveryTime String?
  location     String?
  note         String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int      @default(5)
  text      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

model StoreFavourite {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  sender   User @relation("RequestsSent", fields: [senderId], references: [id])
  receiver User @relation("RequestsReceived", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}